{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug + ASan + UBSan + clang-tidy",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ECML_BUILD_TESTING": "ON",
                "ECML_ENABLE_SANITIZERS": "ON",
                "ECML_ENABLE_CLANG_TIDY": "ON",
                "ECML_WARNINGS_AS_ERRORS": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release with Optimizations",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ECML_BUILD_TESTING": "OFF",
                "ECML_ENABLE_SANITIZERS": "OFF",
                "ECML_ENABLE_CLANG_TIDY": "OFF",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "ECML_WARNINGS_AS_ERRORS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        }
    ]
}
