#include <gtest/gtest.h>

#include "ecml/ecml_ethernet.hpp"

namespace {

constexpr uint16_t ipv4_type = 0x0800;
constexpr uint8_t ethercat_type_msb = 0x88;
constexpr uint8_t ethercat_type_lsb = 0xA4;

const ecml::protocol::MacAddress sample_dst_mac{
    .bytes = {std::byte{0x01}, std::byte{0x02}, std::byte{0x03},
              std::byte{0x04}, std::byte{0x05}, std::byte{0x06}}};

const ecml::protocol::MacAddress sample_src_mac{
    .bytes = {std::byte{0x10}, std::byte{0x20}, std::byte{0x30},
              std::byte{0x40}, std::byte{0x50}, std::byte{0x60}}};

} // namespace

TEST(EthernetHeaderUnit, SerializeSuccessfully) {
  const ecml::protocol::EthernetHeader header{
      .ether_type = ecml::protocol::ethercat_ether_type,
      .dst = sample_dst_mac,
      .src = sample_src_mac,
  };
  std::array<std::byte, ecml::protocol::EthernetHeader::size> buffer{};
  const auto status = header.serialize(buffer);
  EXPECT_EQ(status, ecml::protocol::EthernetSerializeStatus::Success);
  EXPECT_TRUE(std::equal(sample_dst_mac.bytes.begin(),
                         sample_dst_mac.bytes.end(), buffer.begin()));
  EXPECT_TRUE(std::equal(sample_src_mac.bytes.begin(),
                         sample_dst_mac.bytes.end(), buffer.begin()));
  EXPECT_EQ(buffer[12], std::byte{ethercat_type_msb});
  EXPECT_EQ(buffer[13], std::byte{ethercat_type_lsb});
}

TEST(EthernetHeaderUnit, SerializeBufferTooSmall) {
  const ecml::protocol::EthernetHeader header{
      .ether_type = ecml::protocol::ethercat_ether_type,
      .dst = sample_dst_mac,
      .src = sample_src_mac};
  std::array<std::byte, ecml::protocol::EthernetHeader::size - 1>
      small_buffer{};
  const auto status = header.serialize(small_buffer);
  EXPECT_EQ(status, ecml::protocol::EthernetSerializeStatus::BufferTooSmall);
}

TEST(EthernetHeaderUnit, DeserializeSuccess) {
  std::array<std::byte, ecml::protocol::EthernetHeader::size> bytes{};
  std::copy(sample_dst_mac.bytes.begin(), sample_dst_mac.bytes.end(),
            bytes.begin());
  std::copy(sample_src_mac.bytes.begin(), sample_src_mac.bytes.end(),
            bytes.begin() + ecml::protocol::MacAddress::size);
  bytes[12] = std::byte{ethercat_type_msb};
  bytes[13] = std::byte{ethercat_type_lsb};
  const auto res = ecml::protocol::EthernetHeader::deserialize(bytes);
  ASSERT_TRUE(res.ok());
  ASSERT_TRUE(res.header.has_value());
  EXPECT_EQ(res.header->dst, sample_dst_mac);
  EXPECT_EQ(res.header->src, sample_src_mac);
  EXPECT_EQ(res.header->ether_type, ecml::protocol::ethercat_ether_type);
}

TEST(EthernetHeaderUnit, DeserializeUnsupportedEtherType) {
  std::array<std::byte, ecml::protocol::EthernetHeader::size> ipv4_frame{};
  ipv4_frame[12] = std::byte{0x08};
  ipv4_frame[13] = std::byte{0x00};
  const auto res = ecml::protocol::EthernetHeader::deserialize(ipv4_frame);
  EXPECT_FALSE(res.ok());
  EXPECT_FALSE(res.header.has_value());
  EXPECT_EQ(
      res.status,
      ecml::protocol::EthernetDeserializeResult::Status::UnsupportedEtherType);
}

TEST(EthernetHeaderUnit, DeserializeBufferTooSmall) {
  const std::array<std::byte, ecml::protocol::EthernetHeader::size - 1>
      small_buffer{};
  const auto res = ecml::protocol::EthernetHeader::deserialize(small_buffer);
  EXPECT_FALSE(res.ok());
  EXPECT_FALSE(res.header.has_value());
  EXPECT_EQ(res.status,
            ecml::protocol::EthernetDeserializeResult::Status::BufferTooSmall);
}

TEST(EthernetHeaderUnit, DeserializeFromLargerFrameWithPayload) {
  constexpr size_t full_frame_size = 60;
  std::array<std::byte, full_frame_size> frame{};
  frame[12] = std::byte{ethercat_type_msb};
  frame[13] = std::byte{ethercat_type_lsb};

  const auto res = ecml::protocol::EthernetHeader::deserialize(frame);
  ASSERT_TRUE(res.ok());
  ASSERT_TRUE(res.header.has_value());
  EXPECT_EQ(res.header->ether_type, ecml::protocol::ethercat_ether_type);
}

TEST(EthernetHeaderUnit, SerializeDeserializeEquality) {
  const ecml::protocol::EthernetHeader original_header{
      .ether_type = ecml::protocol::ethercat_ether_type,
      .dst = sample_dst_mac,
      .src = sample_src_mac};
  std::array<std::byte, ecml::protocol::EthernetHeader::size> buffer{};
  ASSERT_EQ(original_header.serialize(buffer),
            ecml::protocol::EthernetSerializeStatus::Success);
  const auto res = ecml::protocol::EthernetHeader::deserialize(buffer);
}
